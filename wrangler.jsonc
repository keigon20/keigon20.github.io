// Cloudflare Worker that serves the static Astro build.
// Build-time variables (e.g. PUBLIC_SETLY_CONCERTS_URL) are set in the dashboard under
// Settings → Build → Variables and secrets, not in "vars" below (those are runtime-only).
{
  "name": "keigon20-github-io",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  "vars": {}
}
